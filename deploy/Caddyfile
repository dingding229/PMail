{$PMAIL_WEB_DOMAIN} {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    encode gzip
    reverse_proxy pmail:{$PMAIL_HTTP_PORT}
}

# For each additional PMAIL_DOMAINS entry, add its smtp/imap/pop HTTP hostnames
# below so PMail can complete HTTP-01 for those names too.
http://{$PMAIL_WEB_DOMAIN}, http://smtp.{$PMAIL_DOMAIN}, http://imap.{$PMAIL_DOMAIN}, http://pop.{$PMAIL_DOMAIN} {
    handle /.well-known/acme-challenge/* {
        reverse_proxy pmail:{$PMAIL_HTTP_PORT}
    }
    handle {
        redir https://{$PMAIL_WEB_DOMAIN}{uri} 308
    }
}
