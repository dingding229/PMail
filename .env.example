# 首次部署必改：填写实际邮件域名和网页域名；为 PostgreSQL、管理员和加密密钥分别生成随机值。
PMAIL_DOMAIN=example.com
PMAIL_WEB_DOMAIN=mail.example.com
POSTGRES_PASSWORD=
PMAIL_ADMIN_PASSWORD=
PMAIL_SECRET_KEY=

# 按 README 选择公网直连或外部反代参数；以下模板默认不公开网页，也不启用证书。
PMAIL_SSL_TYPE=3
PMAIL_HTTPS_ENABLED=2
PMAIL_WEB_BIND=127.0.0.1
PMAIL_HOST_HTTP_PORT=80
PMAIL_HOST_HTTPS_PORT=443

# Docker Hub 镜像和 Compose 项目名；多实例必须用不同项目名，并避免宿主机端口冲突。
PMAIL_IMAGE=dingding229/pmail-pro:3.0.0-beta.3
PMAIL_PROJECT_NAME=pmail
# 首次启动创建的管理员账号；修改引导密码不会重置已存在账号。
PMAIL_ADMIN_ACCOUNT=admin
# PostgreSQL 初始数据库名和账号；修改这些值不会重建已有数据库卷。
POSTGRES_DB=pmail
POSTGRES_USER=pmail
# 留空时使用本项目的 PostgreSQL。自定义连接串应对用户名、密码中的保留字符做百分号编码。
# README 的备份、恢复命令适用于本项目的 postgres 服务。
PMAIL_DB_DSN=
# 其他收信域名，逗号分隔；主域名会自动加入。
PMAIL_DOMAINS=
# 容器内网页端口，与宿主机映射端口分开。仅 HTTP 模式下，容器内不监听网页 HTTPS。
PMAIL_HTTP_PORT=80
PMAIL_HTTPS_PORT=443
# 日志级别：debug（调试）、info（信息）、warn（警告）、error（错误）。
PMAIL_LOG_LEVEL=info
# 垃圾邮件过滤：0 关闭；1 SPF 与 DKIM 均失败；2 SPF 失败；3 DKIM 失败。
PMAIL_SPAM_FILTER_LEVEL=0
# 未知本域收件人交给启用的管理员；设为 false 时在 SMTP 入口拒绝未知收件人。
PMAIL_CATCH_ALL=true
# 普通用户是否可以创建自己的别名；管理员不受此限制。
PMAIL_ALLOW_USER_ALIAS=false
# 邮件端口默认绑定所有 IPv4 地址；公网只放行实际使用的端口，不建议公开明文 POP3。
PMAIL_MAIL_BIND=0.0.0.0
PMAIL_HOST_SMTP_PORT=25
PMAIL_HOST_SMTPS_PORT=465
PMAIL_HOST_SUBMISSION_PORT=587
PMAIL_HOST_POP3_PORT=110
PMAIL_HOST_POP3S_PORT=995
PMAIL_HOST_IMAP_PORT=143
PMAIL_HOST_IMAPS_PORT=993
# 以下是进程环境变量，基础 Compose 不透传；如需调整，需用覆盖文件传入容器环境。
# 外发队列并发数，默认 4。
PMAIL_QUEUE_WORKERS=4
# 外部 IMAP/POP3 收取并发数，默认 3。
PMAIL_FETCH_WORKERS=3
