# Compose 项目名；也可通过 shell 环境变量 PMAIL_PROJECT_NAME 优先覆盖。
PMAIL_PROJECT_NAME=pmail
# PostgreSQL 初始数据库名。已有卷不会因修改此值自动重建。
POSTGRES_DB=pmail
# PostgreSQL 初始用户名。
POSTGRES_USER=pmail
# PostgreSQL 初始密码；由 deploy/deploy.sh init 生成随机值。
POSTGRES_PASSWORD=
# 可选 PostgreSQL URL；留空按以上三个变量和 postgres:5432 生成。
# 若密码含 URL 保留字符，填写完整 DSN 并对用户名/密码百分号编码。
# 部署脚本仅备份/恢复 Compose 中的 postgres 服务；使用脚本时 DSN 必须指向此库。
PMAIL_DB_DSN=
# 主邮件域名；上线前替换示例值。
PMAIL_DOMAIN=example.com
# 其他收信域名，逗号分隔；主域名会自动加入。
PMAIL_DOMAINS=
# 管理网页域名；留空回退到主邮件域名。
PMAIL_WEB_DOMAIN=
# 容器内 HTTP 和 HTTPS 监听端口。
PMAIL_HTTP_PORT=80
PMAIL_HTTPS_PORT=443
# 网页 HTTPS：0/1 启用，2 仅 HTTP；SSL 类型 3 时强制仅 HTTP。
PMAIL_HTTPS_ENABLED=2
# 证书：0 ACME HTTP-01；1 用户证书；2 ACME DNS-01；3 不启用证书（仅反代后台）。
PMAIL_SSL_TYPE=3
# 日志级别：debug、info、warn、error。
PMAIL_LOG_LEVEL=info
# 垃圾邮件过滤：0 关闭；1 SPF 与 DKIM 均失败；2 SPF 失败；3 DKIM 失败。
PMAIL_SPAM_FILTER_LEVEL=0
# 未知本域收件人交给启用的管理员；false 时 SMTP 拒绝该收件人。
PMAIL_CATCH_ALL=true
# 普通用户是否可新增自己的别名；管理员不受此限制。
PMAIL_ALLOW_USER_ALIAS=false
# 加密预留密钥；init 生成 32 字节十六进制值，留空由 PMail 写入配置卷。
PMAIL_SECRET_KEY=
# 首次启动创建的管理员账号。
PMAIL_ADMIN_ACCOUNT=admin
# 首次免向导启动需设置；init 会生成。初始化完成后可留空，不影响已有账号。
PMAIL_ADMIN_PASSWORD=
# Web 默认仅本机，需通过反向代理访问；如不使用反代再改为 0.0.0.0。
PMAIL_WEB_BIND=127.0.0.1
# 邮件服务必须能从公网接收 SMTP 25；用防火墙限制其他端口，尤其是允许明文认证的 POP3 110。
PMAIL_MAIL_BIND=0.0.0.0
# SMTP 投递（25）、隐式 TLS（465）、STARTTLS 提交（587）的宿主机端口。
PMAIL_HOST_SMTP_PORT=25
PMAIL_HOST_SMTPS_PORT=465
PMAIL_HOST_SUBMISSION_PORT=587
# POP3（110）及 POP3S（995）的宿主机端口。
PMAIL_HOST_POP3_PORT=110
PMAIL_HOST_POP3S_PORT=995
# IMAP STARTTLS（143）及 IMAPS（993）的宿主机端口。
PMAIL_HOST_IMAP_PORT=143
PMAIL_HOST_IMAPS_PORT=993
# HTTP（80）及 HTTPS（443）的宿主机端口，可独立于容器内端口修改。
PMAIL_HOST_HTTP_PORT=80
PMAIL_HOST_HTTPS_PORT=443
