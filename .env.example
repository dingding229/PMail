# 必填：替换为实际收发邮件的主域名。
PMAIL_DOMAIN=example.com

# 常用可选项：需要时取消注释并修改。直连公网按 README 加载 Compose 覆盖文件。
# PMAIL_WEB_DOMAIN=mail.example.com
# PMAIL_WEB_MODE=proxy
# PMAIL_WEB_ROOT=/work/web
# PMAIL_DEFAULT_LANG=zh-CN
# PMAIL_PUBLIC_IPV4=203.0.113.10
# PMAIL_PUBLIC_IPV6=2001:db8::10
# PMAIL_DNS_RESOLVER=1.1.1.1:53
# PMAIL_CORS_ORIGINS=http://localhost:5173
# 默认使用 dingding229/pmail-pro:latest；固定版本可取消下一行注释。
# PMAIL_IMAGE=dingding229/pmail-pro:v0.0.1
# PMAIL_DOMAINS=
# PMAIL_ADMIN_ACCOUNT=admin

# 安全边界；仅为实际部署选择需要的配置。
# 设为 1 才允许旧初始化监听器。仅回环地址，令牌文件由日志指示，不要对外代理。
# PMAIL_LEGACY_SETUP=0
# 入站 SMTP 的可信中继 CIDR，逗号分隔；默认不信任私网。仅记录信任，不替代 SPF/DKIM/DMARC。
# PMAIL_TRUSTED_RELAYS=
# 默认关闭；110 在 STLS 前拒绝 USER/PASS。必要时仅在隔离网络临时开启。
# PMAIL_POP3_ALLOW_PLAINTEXT_AUTH=false
# 逗号分隔的显式内网 SMTP 目标 CIDR 或精确 MX 主机名；默认拒绝私有/保留地址。
# PMAIL_SMTP_OUTBOUND_ALLOW=
# 逗号分隔的精确收件域；必须验证 MX 的 STARTTLS 证书，否则不降级投递。其他域记录机会式降级。
# PMAIL_SMTP_TLS_REQUIRED_DOMAINS=
# 逗号分隔的可信 Web 反代 CIDR，仅信任实际连接的代理。让代理覆盖 `X-Forwarded-Proto`、正确追加/清理 `X-Forwarded-For` 并保留 `Host`。
# PMAIL_TRUSTED_PROXIES=
# 设为 1 才允许管理员读取、预览、下载或转发他人非草稿邮件，访问会审计。
# PMAIL_ADMIN_MAIL_ACCESS=0
# 仅设为 1 才兼容旧版把密钥打印到 stdout；默认只提示受保护文件路径。
# PMAIL_PRINT_REGISTRATION_KEY=0

# 邮件体积与 POP3 连接预算
# 发信、草稿和手动转发 JSON 请求体的字节上限。默认 32 MiB，可设 1024–134217728；解码后邮件、附件和 MIME 段各有独立上限。
# PMAIL_MAIL_JSON_MAX_BYTES=33554432
# 合计 POP3 110/995 的同时连接数上限（1–4096）。
# PMAIL_POP3_MAX_CONNECTIONS=128
# 每来源 IP 的 POP3 同时连接数上限（1–4096），IPv4-mapped IPv6 合并计数。
# PMAIL_POP3_MAX_PER_IP=8
# POP3 空闲断开秒数（1–3600）；断开不提交待删除标记。
# PMAIL_POP3_IDLE_SECONDS=600

# Optional comma-separated spam phrases override the built-in C8 keyword list.
# An explicitly empty value disables the keyword feature (not all spam checks).
# PMAIL_SPAM_KEYWORDS=
