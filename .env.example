# 必填：替换为实际收发邮件的主域名。
PMAIL_DOMAIN=example.com

# 常用可选项：需要时取消注释并修改。直连公网按 README 加载 Compose 覆盖文件。
# PMAIL_WEB_DOMAIN=mail.example.com
# PMAIL_WEB_MODE=proxy
# PMAIL_WEB_ROOT=/work/web
# PMAIL_DEFAULT_LANG=zh-CN
# PMAIL_PUBLIC_IPV4=203.0.113.10
# PMAIL_PUBLIC_IPV6=2001:db8::10
# PMAIL_DNS_RESOLVER=1.1.1.1:53
# PMAIL_CORS_ORIGINS=http://localhost:5173
# 默认使用 dingding229/pmail-pro:latest；固定版本可取消下一行注释。
# PMAIL_IMAGE=dingding229/pmail-pro:v0.0.1
# PMAIL_DOMAINS=
# PMAIL_ADMIN_ACCOUNT=admin
